# AI JobShield – local configuration (copy to .env)

# Backend
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# MySQL database configuration
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/ai_jobshield
# Or SQLite: sqlite:///./database/jobshield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scoring weights (must sum conceptually: rule + ml)
RULE_WEIGHT=0.6
ML_WEIGHT=0.4

# Rule thresholds
UNREALISTIC_SALARY_INR=80000
UNREALISTIC_DAILY_INR=2000
MAX_UPLOAD_MB=5

# Optional online company lookup (fails gracefully if offline)
ENABLE_ONLINE_LOOKUP=false
ONLINE_LOOKUP_TIMEOUT=4

# OCR – Windows path to tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ML
ML_MODEL_PATH=models/jobshield_model.joblib
ML_ALTERNATIVE=logistic

# Frontend – direct backend URL so auth requests always hit uvicorn
VITE_API_BASE=http://127.0.0.1:8000/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Email verification (REQUIRED for real Gmail delivery)
# Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=AI JobShield <your.address@gmail.com>
SMTP_USE_TLS=true
# Keep false for real email. Tests set this to true automatically.
SMTP_CONSOLE_FALLBACK=false
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
